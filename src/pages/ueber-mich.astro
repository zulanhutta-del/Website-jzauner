---
import BaseLayout from "../layouts/BaseLayout.astro";
import { personJsonLd, breadcrumbJsonLd } from "../data/business";

const crumbs = breadcrumbJsonLd([
  { name: "Startseite", path: "/" },
  { name: "Über mich", path: "/ueber-mich" },
]);
---

<BaseLayout
  title="Über Julian Zauner – Fotograf aus Salzburg"
  description="Lerne Julian Zauner kennen: Fotograf, Videograf & Designer aus Salzburg mit Fokus auf Automobil- und Motorsportfotografie."
  path="/ueber-mich"
  current="ueber-mich"
  jsonLd={[personJsonLd, crumbs]}
>
  <main class="page">
    <div class="about">
      <div>
        <h1 class="title">biografie</h1>
        <div class="bio">
          <p>
            Ich bin Julian Zauner, Fotograf, Videograf und Designer aus Salzburg (Thalgau). Ich mache
            nicht einfach Bilder — ich baue die ganze visuelle Geschichte: von Automobil-, Motorsport-
            und Aerial-Shootings über den Schnitt bis zum Branding drumherum.
          </p>
          <p>
            Ausgebildet an der HTL Salzburg in Grafik- &amp; Mediendesign, habe ich über die Schule die
            Foto- und Videografie entdeckt — seitdem lässt mich das Thema nicht mehr los. Ich arbeite
            mit den neuesten KI-Tools, damit Ideen schneller und mutiger Wirklichkeit werden.
          </p>
          <p>
            Ich freue mich darauf, meine Leidenschaft für Fotografie und Design in spannenden Projekten
            einzusetzen, und lerne dabei gerne laufend Neues dazu.
          </p>
        </div>
      </div>
      <div class="portrait">
        <img src="/images/profilbild/Profilbild2.jpg" alt="Julian Zauner, Fotograf aus Salzburg, mit Kamera" loading="eager" />
      </div>
    </div>
  </main>

  <style>
    .about { max-width: 1400px; margin: 0 auto; padding: var(--header-h) 28px 90px; padding-top: calc(var(--header-h) + 78px); display: grid; grid-template-columns: 1.05fr .95fr; gap: 70px; align-items: start; }
    h1.title { margin-bottom: 64px; }
    .bio p { max-width: 48ch; margin-bottom: 26px; color: #c9ccd2; font-size: 1.08rem; line-height: 1.65; }
    .portrait { position: relative; aspect-ratio: 4/5; border-radius: 4px; overflow: hidden; border: 1px solid var(--line); max-width: 520px; margin-left: auto; }
    .portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

    @media (max-width: 900px) {
      .about { grid-template-columns: 1fr; gap: 40px; padding-top: calc(var(--header-h) + 40px); }
      h1.title { margin-bottom: 36px; }
      .portrait { order: -1; max-width: 420px; margin: 0; }
    }
  </style>
</BaseLayout>
