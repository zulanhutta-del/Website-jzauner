---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { wildlifeGallery } from "../data/galleries";
import { breadcrumbJsonLd, serviceJsonLd, galleryImagesJsonLd } from "../data/business";

const path = "/wildlife-fotografie";
const crumbs = breadcrumbJsonLd([
  { name: "Startseite", path: "/" },
  { name: "Wildlife-Fotografie", path },
]);
const service = serviceJsonLd({
  name: "Wildlife- & Tierfotografie Salzburg",
  serviceType: "Wildlife-Fotografie",
  description:
    "Wildlife- und Tierfotografie aus Salzburg: Vögel, Insekten und Wildtiere in Nah- und Makroaufnahmen, mit Geduld und Blick fürs Detail von Julian Zauner.",
  path,
});
const images = galleryImagesJsonLd(wildlifeGallery, path);
---

<BaseLayout
  title="Wildlife- & Tierfotografie Salzburg | Julian Zauner"
  description="Wildlife- und Tierfotografie aus Salzburg: Vögel, Insekten und Wildtiere in Makro- und Naturaufnahmen von Julian Zauner."
  path="/wildlife-fotografie"
  current="wildlife-fotografie"
  jsonLd={[crumbs, service, images]}
>
  <main class="page">
    <div class="head">
      <div class="crumbs"><a href="/">Startseite</a> / wildlife</div>
      <h1 class="title">wildlife</h1>
      <p class="intro">Wildlife- &amp; Naturfotografie aus Salzburg — Vögel, Insekten und Wildtiere in Nah- und Makroaufnahmen.</p>
    </div>
    <GalleryGrid shots={wildlifeGallery} />
  </main>
</BaseLayout>
