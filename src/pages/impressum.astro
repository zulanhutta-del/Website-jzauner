---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Impressum | Julian Zauner"
  description="Impressum von Julian Zauner Fotografie, Salzburg."
  path="/impressum"
  current=""
>
  <main class="page">
    <div class="legal">
      <h1 class="title">impressum</h1>
      <div class="body">
        <p><strong>Diese Seite ist ein Platzhalter.</strong> Der rechtlich verbindliche Impressum-Text (Angaben nach § 5 ECG / Mediengesetz) muss noch von Julian ergänzt werden, bevor die Website live geht.</p>
        <p>
          Julian Zauner<br />
          5303 Thalgau, Salzburg, Österreich<br />
          E-Mail: julianzauner@icloud.com
        </p>
      </div>
    </div>
  </main>

  <style>
    .legal { max-width: 800px; margin: 0 auto; padding: calc(101px + 78px) 28px 90px; }
    .body p { color: var(--muted); margin-bottom: 20px; line-height: 1.7; max-width: 65ch; }
    .body strong { color: var(--text); }
  </style>
</BaseLayout>
