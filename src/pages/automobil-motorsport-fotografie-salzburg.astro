---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { automotiveGallery, motorsportGallery } from "../data/galleries";
import { breadcrumbJsonLd, serviceJsonLd, galleryImagesJsonLd } from "../data/business";

const path = "/automobil-motorsport-fotografie-salzburg";
const crumbs = breadcrumbJsonLd([
  { name: "Startseite", path: "/" },
  { name: "Automobil- & Motorsportfotografie Salzburg", path },
]);
const automobilService = serviceJsonLd({
  name: "Automobilfotografie Salzburg",
  serviceType: "Automobilfotografie",
  description:
    "Cinematische Automobilfotografie in Salzburg: Car-Shootings, Rolling Shots, Detail- und Interieuraufnahmen für Autohäuser, Tuner, Sammler und Privatpersonen – inklusive professioneller Bildbearbeitung.",
  path,
});
const motorsportService = serviceJsonLd({
  name: "Motorsportfotografie Salzburg & Österreich",
  serviceType: "Motorsportfotografie",
  description:
    "Motorsportfotografie auf der Rennstrecke: Renntag-Coverage, Action- und Panning-Aufnahmen, Drift- und Boxengassen-Bilder für Teams, Fahrer und Sponsoren in Salzburg und ganz Österreich.",
  path,
});
const images = galleryImagesJsonLd([...automotiveGallery, ...motorsportGallery], path, 16);

const faqs = [
  {
    q: "Was kostet ein Auto-Shooting in Salzburg?",
    a: "Der Preis hängt von Umfang, Ort und Anzahl der Fahrzeuge ab – ein kurzes Detail-Shooting ist etwas anderes als ein ganzer Drehtag mit Rolling Shots und mehreren Autos. Am besten schilderst du dein Projekt kurz per Anfrage, dann bekommst du ein konkretes, unverbindliches Angebot inklusive Bildbearbeitung.",
  },
  {
    q: "Was ist ein Rolling Shot?",
    a: "Ein Rolling Shot ist eine Aufnahme des fahrenden Autos, bei der das Fahrzeug scharf bleibt, während Straße und Hintergrund durch Bewegungsunschärfe verwischen. So entsteht echtes Tempo im Bild. Fotografiert wird dabei aus einem vorausfahrenden Fahrzeug bei abgesicherten Bedingungen.",
  },
  {
    q: "Fotografierst du auch am Renntag auf der Rennstrecke?",
    a: "Ja. Motorsport-Coverage auf der Strecke gehört zum Kern meiner Arbeit – Panning-Shots, Action in den Kurven, Drift, Boxengasse und Fahrerporträts. Die Bilder eignen sich für Teams, Fahrer und Sponsoren, für Social Media genauso wie für Print.",
  },
  {
    q: "In welchem Gebiet bist du als Automobilfotograf tätig?",
    a: "Mein Standort ist Thalgau bei Salzburg. Ich arbeite in der Stadt Salzburg, im gesamten Salzburger Land und in ganz Österreich. Für größere Projekte sind Shootings auch darüber hinaus möglich.",
  },
  {
    q: "Wie läuft ein Auto-Shooting ab?",
    a: "Zuerst klären wir Idee, Location und Look. Beim Shooting entstehen Außen-, Detail- und Interieuraufnahmen, auf Wunsch Rolling Shots. Danach folgt die professionelle Bildbearbeitung. Du erhältst die final bearbeiteten Bilder in Web- und Druckauflösung.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Automobilfotografie & Motorsportfotografie Salzburg | Julian Zauner"
  description="Automobil- und Motorsportfotografie in Salzburg: cinematische Car-Shootings, Rolling Shots, Detailaufnahmen und Renntag-Coverage. Jetzt Projekt anfragen."
  path="/automobil-motorsport-fotografie-salzburg"
  current="automobil-motorsport-fotografie-salzburg"
  jsonLd={[crumbs, automobilService, motorsportService, images, faqJsonLd]}
>
  <main class="page">
    <div class="head">
      <div class="crumbs"><a href="/">Startseite</a> / automobil &amp; motorsport</div>
      <h1 class="title">automobil &amp; motorsport</h1>
      <p class="intro">Automobil- &amp; Motorsportfotografie in Salzburg.</p>
    </div>

    <div class="gallery-head">
      <h2>Automobilfotografie</h2>
    </div>
    <GalleryGrid shots={automotiveGallery} />

    <div class="gallery-head" id="motorsport">
      <h2>Motorsportfotografie</h2>
    </div>
    <GalleryGrid shots={motorsportGallery} />

    <section class="seo-block">
      <div class="seo-text">
        <h2>automobil- &amp; motorsportfotografie in salzburg</h2>
        <p class="lead">
          Julian Zauner ist ein auf Automobil- und Motorsportfotografie spezialisierter Fotograf
          aus Thalgau bei Salzburg. Er fotografiert Autos, Fahrzeugdetails und Rolling Shots für
          Autohäuser, Tuner, Sammler und Privatpersonen – und begleitet Renntage auf der Strecke
          für Teams, Fahrer und Sponsoren.
        </p>
        <p>
          Von cinematischen Car-Shootings mit Rolling Shots über Detail- und Interieuraufnahmen bis
          zur Action am Renntag: Jedes Projekt entsteht mit Blick auf Licht, Tempo und Charakter des
          Fahrzeugs – inklusive professioneller Bildbearbeitung und Lieferung in Web- und
          Druckauflösung. Tätig in Salzburg, dem Salzburger Land und ganz Österreich.
        </p>
      </div>

      <div class="faq">
        <h3 class="faq-title">häufige fragen</h3>
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span>{f.q}</span>
              <span class="mark" aria-hidden="true"></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <style>
    .gallery-head { max-width: 1600px; margin: 0 auto; padding: 10px 0 24px; scroll-margin-top: calc(var(--header-h) + 20px); }
    .gallery-head h2 { font-weight: 700; font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -.01em; text-transform: lowercase; }

    /* ---- SEO/GEO Text- & FAQ-Block (unter den Galerien) ---- */
    .seo-block {
      max-width: 1600px; margin: 0 auto; padding: 40px 0 110px;
      display: grid; grid-template-columns: 1.1fr .9fr; gap: 72px; align-items: start;
      border-top: 1px solid var(--line-soft); margin-top: 24px;
    }
    .seo-block { padding-top: 70px; }
    .seo-text h2 {
      font-weight: 700; font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -.01em;
      text-transform: lowercase; margin-bottom: 26px;
    }
    .seo-text .lead { color: var(--text); font-size: 1.08rem; line-height: 1.7; margin-bottom: 20px; max-width: 56ch; }
    .seo-text p { color: var(--muted); line-height: 1.7; max-width: 56ch; }

    .faq-title {
      font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--accent);
      margin-bottom: 14px;
    }
    .faq-item { border-bottom: 1px solid var(--line); }
    .faq-item summary {
      list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between;
      gap: 20px; padding: 20px 2px; color: #fff; font-size: 1.04rem; font-weight: 500;
      transition: color .2s;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:hover { color: var(--accent-hi); }
    .faq-item .mark { position: relative; flex: none; width: 15px; height: 15px; }
    .faq-item .mark::before, .faq-item .mark::after {
      content: ""; position: absolute; left: 0; top: 7px; width: 15px; height: 1.5px;
      background: var(--accent); transition: transform .3s ease;
    }
    .faq-item .mark::after { transform: rotate(90deg); }
    .faq-item[open] .mark::after { transform: rotate(0); }
    .faq-item[open] summary { color: var(--accent-hi); }
    .faq-item p { color: var(--muted); line-height: 1.7; padding: 0 2px 22px; max-width: 60ch; }

    @media (max-width: 900px) {
      .seo-block { grid-template-columns: 1fr; gap: 44px; padding-bottom: 80px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .faq-item .mark::before, .faq-item .mark::after { transition: none; }
    }
  </style>
  <script>
    const id = location.hash.slice(1);
    if (id) {
      const go = () => document.getElementById(id)?.scrollIntoView({ block: "start" });
      window.addEventListener("load", go);
      setTimeout(go, 800);
    }
  </script>
</BaseLayout>
