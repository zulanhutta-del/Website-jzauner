---
import BaseLayout from "../layouts/BaseLayout.astro";
import { heroSlides } from "../data/galleries";
---

<BaseLayout
  title="Fotograf Salzburg – Automobil & Motorsport | Julian Zauner"
  description="Julian Zauner: Fotograf & Videograf aus Salzburg, spezialisiert auf Automobil- und Motorsportfotografie. Cinematische Bilder, jetzt Projekt anfragen."
  path="/"
  current=""
>
  <main id="top">
    <!-- HERO CAROUSEL -->
    <section class="hero" id="hero" aria-roledescription="carousel" aria-label="Themen-Carousel">
      <div class="carousel" id="carousel">
        {heroSlides.map((slide, i) => (
          <div class:list={["slide", { "is-active": i === 0 }]} data-cat={slide.title}>
            <div class="slide-bg" style={`background-image:url(${slide.img});background-size:cover;background-position:center`}></div>
            <img src={slide.img} alt={slide.alt} class="sr-only-img" loading={i === 0 ? "eager" : "lazy"} />
            <div class="wrap slide-content">
              <h1 class="slide-title">{slide.title}</h1>
              <div class="slide-cta">
                <a class="btn-pill" href={slide.href}>Galerie ansehen <span class="ar">→</span></a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="car-dots" id="carDots" role="tablist" aria-label="Themen"></div>
    </section>

    <!-- ABOUT TEASER -->
    <section class="sec wrap" id="ueber">
      <div class="about">
        <div class="reveal">
          <h2 style="text-transform:none">Willkommen auf meiner Website.</h2>
          <p>
            Hi, ich bin Julian Zauner, Fotograf, Videograf und Designer aus Salzburg. Ich mache nicht
            einfach Bilder — ich baue die ganze visuelle Geschichte: von Automobil-, Motorsport- und
            Aerial-Shootings über den Schnitt bis zum Branding drumherum. Du hast eine Idee? Lass uns
            daraus etwas machen, das man sich zweimal ansieht.
          </p>
          <a class="btn-pill" href="/ueber-mich" style="margin-top:16px;border-color:rgba(255,255,255,.35)">mehr erfahren</a>
        </div>
        <div class="about-photo reveal">
          <img src="/images/profilbild/Profilbild1.jpg" alt="Julian Zauner mit Kamera" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- LATEST WORK -->
    <section class="sec wrap" id="arbeiten">
      <div class="sec-head reveal">
        <h2 style="text-transform:none">Neueste Arbeiten</h2>
      </div>
      <div class="work">
        <a class="tile big reveal" href="/automobil-motorsport-fotografie-salzburg">
          <img class="ph" src="/images/cars/automotive/_MG_7711.jpg" alt="Automobilfotografie" loading="lazy" />
          <span class="go">↗</span>
          <span class="cap">Automobilfotografie</span>
          <h3>Automobil</h3>
        </a>
        <a class="tile tall reveal" href="/automobil-motorsport-fotografie-salzburg#motorsport">
          <img class="ph" src="/images/cars/motorsport/_MG_1481.jpg" alt="Motorsportfotografie" loading="lazy" style="object-position: 63% 50%;" />
          <span class="go">↗</span>
          <span class="cap">Motorsport · Strecke</span>
          <h3>Motorsport</h3>
        </a>
        <a class="tile third reveal" href="/kreativ">
          <img class="ph" src="/images/creative/creative-01-ski-goggles.jpg" alt="Kreative Fotografie" loading="lazy" />
          <span class="go">↗</span>
          <span class="cap">Kreativ · Composing</span>
          <h3>Kreativ</h3>
        </a>
        <a class="tile third reveal" href="/landschaftsfotografie-salzburg">
          <img class="ph" src="/images/landscape/landscape-01-corsica-hairpin.jpg" alt="Landschaftsfotografie" loading="lazy" />
          <span class="go">↗</span>
          <span class="cap">Alpine Landschaft</span>
          <h3>Landschaft</h3>
        </a>
        <a class="tile third reveal" href="/wildlife-fotografie">
          <img class="ph" src="/images/wildlife/wildlife-23-wasp-wood.jpg" alt="Wildlife-Fotografie" loading="lazy" style="object-position: 50% 60%;" />
          <span class="go">↗</span>
          <span class="cap">Wildlife</span>
          <h3>Wildlife</h3>
        </a>
      </div>
    </section>

  </main>

  <style>
    .sr-only-img { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }

    .hero { position: relative; height: 100vh; min-height: 620px; overflow: hidden; background: #000; }
    .carousel { position: absolute; inset: 0; }
    .slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 1.1s ease, visibility 1.1s; }
    .slide.is-active { opacity: 1; visibility: visible; }
    .slide-bg { position: absolute; inset: 0; transform: scale(1.05); transition: transform 7s ease; }
    .slide.is-active .slide-bg { transform: scale(1); }
    .slide::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, transparent 26%, transparent 52%, rgba(0,0,0,.82) 100%),
                  radial-gradient(120% 80% at 50% 120%, rgba(0,0,0,.6), transparent 60%);
    }
    .slide-content { position: absolute; left: 0; right: 0; top: 57vh; bottom: auto; z-index: 3; }
    .slide-title {
      font-weight: 800; color: #fff; text-transform: uppercase; letter-spacing: -.02em;
      line-height: .94; font-size: clamp(2.6rem, 8vw, 7rem); text-wrap: balance;
      opacity: 0; transform: translateY(22px); transition: .8s .1s;
      display: flex; align-items: flex-end; min-height: 1.9em;
    }
    .slide.is-active .slide-title { opacity: 1; transform: none; }
    .slide-cta { margin-top: 38px; opacity: 0; transform: translateY(18px); transition: .8s .3s; }
    .slide.is-active .slide-cta { opacity: 1; transform: none; }
    .car-dots { position: absolute; left: 0; right: 0; bottom: 40px; z-index: 5; display: flex; gap: 12px; justify-content: center; align-items: center; }
    .car-dots :global(button) { width: 9px; height: 9px; border: 0; padding: 0; border-radius: 50%; background: rgba(255,255,255,.35); cursor: pointer; transition: background .3s, transform .3s; }
    .car-dots :global(button.on) { background: var(--accent); transform: scale(1.55); }
    .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }

    .about { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
    .about-photo { position: relative; aspect-ratio: 4/5; border-radius: 3px; overflow: hidden; border: 1px solid var(--line); }
    .about-photo img { width: 100%; height: 100%; object-fit: cover; }
    .about h2 { font-weight: 800; font-size: clamp(1.8rem, 3.6vw, 2.8rem); line-height: 1.05; letter-spacing: -.02em; margin: 14px 0 22px; }
    .about p { color: var(--muted); margin-bottom: 18px; max-width: 54ch; }

    .work { display: grid; grid-template-columns: repeat(6,1fr); gap: 16px; }
    .tile {
      position: relative; overflow: hidden; border-radius: 3px; border: 1px solid var(--line-soft);
      min-height: 280px; display: flex; flex-direction: column; justify-content: flex-end;
      padding: 24px; cursor: pointer; isolation: isolate;
      transition: transform .5s cubic-bezier(.2,.7,.2,1), border-color .3s;
    }
    .tile:hover { border-color: var(--accent); }
    .tile .ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
    .tile:hover .ph { transform: scale(1.06); }
    .tile::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 30%, rgba(8,9,11,.86) 100%); }
    .tile .cap { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
    .tile h3 { font-weight: 800; font-size: 1.5rem; text-transform: uppercase; letter-spacing: -.01em; margin-top: 6px; }
    .tile .go { position: absolute; top: 20px; right: 20px; color: var(--accent); opacity: 0; transform: translate(-6px,6px); transition: opacity .3s, transform .3s; font-size: 20px; }
    .tile:hover .go { opacity: 1; transform: translate(0,0); }
    .tile.big { grid-column: span 4; min-height: 520px; }
    .tile.tall { grid-column: span 2; min-height: 520px; }
    .tile.third { grid-column: span 2; }

    @media (max-width: 900px) {
      .work { grid-template-columns: repeat(2,1fr); }
      .tile.big, .tile.tall, .tile.third { grid-column: span 2; min-height: 300px; }
      .about { grid-template-columns: 1fr; gap: 36px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .tile .ph, .tile:hover .ph { transition: none; }
    }
  </style>

  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: .14 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    (function () {
      const slides = [...document.querySelectorAll('.slide')] as HTMLElement[];
      const dotsWrap = document.getElementById('carDots');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let i = 0;
      let timer: ReturnType<typeof setInterval> | null = null;
      slides.forEach((s, idx) => {
        const b = document.createElement('button');
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-label', s.dataset.cat || `Thema ${idx + 1}`);
        if (idx === 0) b.classList.add('on');
        b.addEventListener('click', () => { go(idx); reset(); });
        dotsWrap?.appendChild(b);
      });
      const dots = dotsWrap ? [...dotsWrap.children] : [];
      function go(n: number) {
        slides[i].classList.remove('is-active');
        dots[i]?.classList.remove('on');
        i = (n + slides.length) % slides.length;
        slides[i].classList.add('is-active');
        dots[i]?.classList.add('on');
      }
      function next() { go(i + 1); }
      function reset() {
        if (reduce) return;
        if (timer) clearInterval(timer);
        timer = setInterval(next, 3000);
      }
      const hero = document.getElementById('hero');
      hero?.addEventListener('mouseenter', () => { if (timer) clearInterval(timer); });
      hero?.addEventListener('mouseleave', reset);
      reset();
    })();
  </script>
</BaseLayout>
