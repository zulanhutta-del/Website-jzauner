---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { landscapeGallery } from "../data/galleries";
import { breadcrumbJsonLd, serviceJsonLd, galleryImagesJsonLd } from "../data/business";

const path = "/landschaftsfotografie-salzburg";
const crumbs = breadcrumbJsonLd([
  { name: "Startseite", path: "/" },
  { name: "Landschaftsfotografie Salzburg", path },
]);
const service = serviceJsonLd({
  name: "Landschaftsfotografie Salzburg & Alpen",
  serviceType: "Landschaftsfotografie",
  description:
    "Landschafts- und Naturfotografie in Salzburg, den Alpen und auf Reisen: Bergpanoramen, Sonnenuntergänge, Küsten- und Drohnenaufnahmen von Julian Zauner.",
  path,
});
const images = galleryImagesJsonLd(landscapeGallery, path);
---

<BaseLayout
  title="Landschaftsfotografie Salzburg | Julian Zauner"
  description="Landschaftsfotografie in Salzburg und den Alpen: Berge, Küsten und Naturstimmungen von Julian Zauner, Fotograf aus Thalgau/Salzburg."
  path="/landschaftsfotografie-salzburg"
  current="landschaftsfotografie-salzburg"
  jsonLd={[crumbs, service, images]}
>
  <main class="page">
    <div class="head">
      <div class="crumbs"><a href="/">Startseite</a> / landschaft</div>
      <h1 class="title">landschaft</h1>
      <p class="intro">Landschaftsfotografien aus Salzburg, Italien, Korsika und Frankreich — von Bergpanoramen über idyllische Sonnenuntergänge bis zu Küstenstimmungen.</p>
    </div>
    <GalleryGrid shots={landscapeGallery} />
  </main>
</BaseLayout>
