---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbJsonLd, serviceJsonLd } from "../data/business";

const path = "/fotograf-salzburg";
const crumbs = breadcrumbJsonLd([
  { name: "Startseite", path: "/" },
  { name: "Fotograf Salzburg", path },
]);
const service = serviceJsonLd({
  name: "Fotograf Salzburg – Foto, Video & Design",
  serviceType: "Fotografie, Videografie & Grafikdesign",
  description:
    "Julian Zauner ist Fotograf, Videograf und Designer aus Salzburg (Thalgau). Foto, Video und Design aus einer Hand – mit Schwerpunkt Automobil- und Motorsportfotografie, dazu Wildlife, Landschaft, Kreativ und Branding, für Kunden in Salzburg und ganz Österreich.",
  path,
});
---

<BaseLayout
  title="Fotograf Salzburg – Foto, Video, Design | Julian Zauner"
  description="Dein Fotograf in Salzburg für Automobil, Motorsport, Wildlife & Landschaft. Foto, Video und Design aus einer Hand. Jetzt unverbindlich anfragen."
  path="/fotograf-salzburg"
  current=""
  jsonLd={[crumbs, service]}
>
  <main class="page">
    <div class="head">
      <div class="crumbs"><a href="/">Startseite</a> / fotograf salzburg</div>
      <h1 class="title">fotograf salzburg</h1>
      <p class="intro">Foto, Video und Design aus Salzburg — Automobil, Motorsport, Wildlife, Landschaft und Kreativ.</p>
    </div>
  </main>

  <style>
  </style>
</BaseLayout>
