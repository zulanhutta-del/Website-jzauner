---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbJsonLd } from "../data/business";

const crumbs = breadcrumbJsonLd([
  { name: "Startseite", path: "/" },
  { name: "Grafikdesign", path: "/design" },
]);

const posterPair = [
  {
    img: "/images/Grafikdesign/design-01-ferrari-aesthetics.jpg",
    alt: "Poster „Ferrari Aesthetics“ für den Ferrari 296 GTB",
    cat: "Editorial Design · Fotografie",
    title: "Ferrari Aesthetics",
    meta: "Posterdesign · 2026",
  },
  {
    img: "/images/Grafikdesign/design-08-lando-norris-poster.jpg",
    alt: "Sport-Poster von Lando Norris (McLaren F1) beim Singapore GP 2023",
    cat: "Poster · Sportdesign",
    title: "motorsportposter - mclaren f1",
    meta: "Posterdesign · 2026",
  },
];

const projects = [
  {
    type: "cluster",
    flip: false,
    cat: "Branding · Editorial Design · Druck",
    title: "surfer mag „breakzone“",
    text: "Editorial-Design-Projekt: ein Surf-Magazin von der Coverseite bis zu den Innenspreads — Titel, Raster, Typografie und Bildsprache für ein durchgängiges Heftgefühl.",
    meta: "Editorial · 2023",
    images: [
      { src: "/images/Grafikdesign/design-02-breakzone-cover.jpg", alt: "Cover des Surf-Magazins „Breakzone“", style: "width:56%; top:0; right:0; z-index:3; transform:rotate(1.5deg);" },
      { src: "/images/Grafikdesign/design-02b-breakzone-spread1.jpg", alt: "Innenspread des Surf-Magazins „Breakzone“, Windsurfer im Wellental", style: "width:52%; bottom:6%; left:0; z-index:2; transform:rotate(-2deg);" },
      { src: "/images/Grafikdesign/design-02c-breakzone-spread2.jpg", alt: "Innenspread des Surf-Magazins „Breakzone“, Surfer in der Röhre", style: "width:40%; bottom:0; right:10%; z-index:1; transform:rotate(2deg);" },
    ],
  },
  {
    type: "cluster",
    flip: false,
    cat: "Produkt Kampagne · Fotografie",
    title: "atomic revent goggle",
    text: "Foto- &amp; Design-Projekt für die Skibrille „Revent Goggle“ — Produktinszenierung und Anzeigen-Layout mit technischer Bildsprache. Model: Luna Ceschin.",
    meta: "Produktdesign · 2024",
    images: [
      { src: "/images/Grafikdesign/design-04-atomic-revent-goggle.jpg", alt: "Werbe-Sujet Atomic Revent Goggle, Model im Dehnsprung", style: "width:46%; top:0; left:4%; z-index:2; transform:rotate(-2deg);" },
      { src: "/images/Grafikdesign/design-04b-atomic-revent-goggle-2.jpg", alt: "Werbe-Sujet Atomic Revent Goggle, Model kniend", style: "width:48%; top:4%; right:0; z-index:3; transform:rotate(1.5deg);" },
      { src: "/images/Grafikdesign/design-04c-atomic-revent-goggle-3.jpg", alt: "Werbe-Sujet Atomic Revent Goggle, Model im Profil", style: "width:38%; bottom:0; left:22%; z-index:1; transform:rotate(2deg);" },
    ],
  },
  {
    type: "video",
    flip: true,
    video: "/images/Grafikdesign/design-03-reride-slideshow.mp4",
    poster: "/images/Grafikdesign/design-03-reride-card.png",
    alt: "RERIDE Corporate-Design-Slideshow",
    cat: "Corporate Design",
    title: "reride",
    text: "Schulprojekt 2024: ein komplettes Corporate Design aus einer eigenen Idee entwickelt — Logo, Geschäftsausstattung (inkl. Visitenkarte) und drei Werbeposter.",
    meta: "Branding · Logo · Print · 2024",
  },
  {
    type: "video",
    flip: false,
    video: "/images/Grafikdesign/design-05-imagefolder-slideshow.mov",
    poster: "/images/Grafikdesign/design-05-imagefolder-regear.jpg",
    alt: "Image-Folder „Regear“ Slideshow",
    cat: "Broschüre · InDesign",
    title: "image-folder",
    text: "Schulprojekt 2023, gestaltet und produziert in Adobe InDesign: eine Image-Broschüre für eine Marke — inklusive Konkurrenzanalyse sowie Satzspiegel, Layout und Raster.",
    meta: "Editorial · Print · 2023",
  },
  {
    type: "single",
    flip: true,
    img: "/images/Grafikdesign/design-06-kuehberger-poster.jpg",
    alt: "Werbeplakat „Handwerk Tradition Design“ für Kühberger Schmuckdesign",
    cat: "Branding · Druck · Produkt Fotografie",
    title: "kühberger schmuckdesign",
    text: "Werbeplakat für das Schmuckatelier Kühberger — Handwerk, Tradition und Design in einem ruhigen, hochwertigen Bildkonzept mit Fokus auf die Ringe und das Markenversprechen.",
    meta: "Posterdesign · Branding",
  },
  {
    type: "single",
    flip: false,
    img: "/images/Grafikdesign/design-07-fullstack-packaging.jpg",
    alt: "Verpackungsdesign „Full Stack“ Proteinriegel für die Marke FULLSTACK",
    cat: "Branding · Verpackungsdesign",
    title: "beastblock protein-bar",
    text: "Verpackungsdesign für einen Proteinriegel — Markenauftritt, Typografie und Produktrendering für ein kraftvolles, sportliches Packaging.",
    meta: "Packaging · Produktdesign",
  },
];
---

<BaseLayout
  title="Grafikdesign Salzburg | Julian Zauner"
  description="Grafikdesign aus Salzburg: Branding, Editorial und Posterdesign von Julian Zauner — u.a. Ferrari-Poster, Corporate Design und Editorial für ein Surf-Magazin."
  path="/design"
  current="design"
  jsonLd={[crumbs]}
>
  <main class="page">
    <div class="head">
      <div class="crumbs"><a href="/">Startseite</a> / design</div>
      <h1 class="title">grafikdesign</h1>
      <p class="intro">Meine Stärke liegt nicht nur in der Fotografie, sondern auch im Grafikdesign — von Corporate Design über Editorial bis Packaging. Eine Auswahl meiner Arbeiten.</p>
    </div>

    <div class="projects">
      <div class="proj" class:list={[{ flip: projects[0].flip }]}>
        <div class="proj-cluster">
          {projects[0].images!.map((im) => (
            <img src={im.src} alt={im.alt} loading="lazy" style={im.style} />
          ))}
        </div>
        <div class="proj-text">
          <span class="cat">{projects[0].cat}</span>
          <h3>{projects[0].title}</h3>
          <p set:html={projects[0].text} />
          <div class="meta">{projects[0].meta}</div>
        </div>
      </div>

      <div class="poster-pair">
        {posterPair.map((p) => (
          <div class="pair-col">
            <div class="pair-cap">
              <span class="cat">{p.cat}</span>
              <h3>{p.title}</h3>
              <div class="meta">{p.meta}</div>
            </div>
            <img src={p.img} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>

      {projects.slice(1).map((p) => (
        <div class="proj" class:list={[{ flip: p.flip }]}>
          {p.type === "cluster" ? (
            <div class="proj-cluster">
              {p.images!.map((im) => (
                <img src={im.src} alt={im.alt} loading="lazy" style={im.style} />
              ))}
            </div>
          ) : p.type === "video" ? (
            <div class="proj-media">
              <video class="scroll-video" controls muted loop playsinline preload="metadata" poster={p.poster} aria-label={p.alt}>
                <source src={p.video} />
              </video>
            </div>
          ) : (
            <div class="proj-media">
              <img src={p.img} alt={p.alt} loading="lazy" />
            </div>
          )}
          <div class="proj-text">
            <span class="cat">{p.cat}</span>
            <h3>{p.title}</h3>
            <p set:html={p.text} />
            <div class="meta">{p.meta}</div>
          </div>
        </div>
      ))}

      <div class="proj flip">
        <div class="proj-logos">
          <img class="logo-monamo" src="/images/Grafikdesign/design-09-monamo-logo.png" alt="monamo Logo" loading="lazy" />
        </div>
        <div class="proj-text">
          <span class="cat">Logos · Branding</span>
          <h3>monamo</h3>
          <p>Logodesign für monamo Anti-Schuppen-Shampoo.</p>
          <div class="meta">Logo · Branding</div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .projects { max-width: 1400px; margin: 0 auto; padding: 40px 28px 100px; display: flex; flex-direction: column; gap: 140px; }
    .proj { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .proj.flip .proj-media,
    .proj.flip .proj-cluster,
    .proj.flip .proj-logos { order: 2; }

    .proj-media img, .proj-media video {
      display: block; width: 100%; height: auto; border-radius: 2px;
      box-shadow: 0 24px 60px rgba(0,0,0,.5); background: #000;
    }

    .proj-cluster { position: relative; min-height: 440px; }
    .proj-cluster img {
      position: absolute; border-radius: 2px; box-shadow: 0 20px 50px rgba(0,0,0,.55);
      display: block; width: 100%; height: auto;
    }

    .poster-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: end; max-width: 66%; margin-left: auto; }
    .pair-col img {
      display: block; width: 56%; height: auto; border-radius: 2px;
      box-shadow: 0 24px 60px rgba(0,0,0,.5);
      margin-left: auto;
    }
    .pair-cap { margin-bottom: 20px; }

    .proj-logos { display: flex; align-items: center; gap: 40px; flex-wrap: wrap; }
    .logo-monamo { width: 220px; max-width: 46%; border-radius: 2px; box-shadow: 0 16px 40px rgba(0,0,0,.4); }

    .proj-text .cat, .pair-cap .cat { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #970303; }
    .proj-text h3, .pair-cap h3 { font-weight: 700; font-size: clamp(1.5rem,2.6vw,2.2rem); letter-spacing: -.01em; margin: 14px 0 14px; text-transform: lowercase; }
    .pair-cap h3 { font-size: clamp(1.2rem,2vw,1.6rem); margin: 10px 0 8px; }
    .proj-text p { color: var(--muted); max-width: 46ch; }
    .proj-text .meta, .pair-cap .meta { margin-top: 16px; font-size: 12px; color: var(--muted-2); letter-spacing: .04em; }

    @media (max-width: 900px) {
      .proj { grid-template-columns: 1fr; gap: 28px; }
      .proj.flip .proj-media,
      .proj.flip .proj-cluster,
      .proj.flip .proj-logos { order: 0; }
      .projects { gap: 90px; padding: 40px 20px 100px; }

      .proj-cluster { min-height: 0; display: flex; flex-direction: column; gap: 16px; }
      .proj-cluster img { position: static; width: 100%; transform: none !important; }

      .poster-pair { grid-template-columns: 1fr; gap: 48px; max-width: 100%; margin-left: 0; }
      .pair-col img { width: 100%; margin-left: 0; }
    }
  </style>

  <script>
    const videos = document.querySelectorAll<HTMLVideoElement>(".scroll-video");
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.5 }
    );
    videos.forEach((v) => io.observe(v));
  </script>
</BaseLayout>
